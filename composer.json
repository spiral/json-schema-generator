{
  "name": "spiral/json-schema-generator",
  "description": "Provides the ability to generate JSON schemas from Data Transfer Object (DTO) classes",
  "keywords": [
    "json-schema",
    "json-schema-generator",
    "schema",
    "dto",
    "data-transfer-object",
    "llm",
    "ai",
    "openai",
    "structured-output",
    "function-calling",
    "tool-calling",
    "attributes",
    "spiral"
  ],
  "homepage": "https://github.com/spiral/json-schema-generator",
  "license": "MIT",
  "authors": [
    {
      "name": "Anton Titov (wolfy-j)",
      "email": "wolfy-j@spiralscout.com"
    },
    {
      "name": "Pavel Buchnev (butschster)",
      "email": "pavel.buchnev@spiralscout.com"
    },
    {
      "name": "Aleksei Gagarin (roxblnfk)",
      "email": "alexey.gagarin@spiralscout.com"
    },
    {
      "name": "Maksim Smakouz (msmakouz)",
      "email": "maksim.smakouz@spiralscout.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "symfony/property-info": "^7.2.0 || ^8.0.0",
    "phpstan/phpdoc-parser": "^1.33 | ^2.1",
    "phpdocumentor/reflection-docblock": "^5.3 || ^6.0"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "rector/rector": "^2.0",
    "testo/bridge-infection": "^0.1.9",
    "testo/testo": "^0.10.56"
  },
  "autoload": {
    "psr-4": {
      "Spiral\\JsonSchemaGenerator\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Spiral\\JsonSchemaGenerator\\Tests\\": "tests"
    }
  },
  "scripts": {
    "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
    "cs:fix": "php-cs-fixer fix -v --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
    "infect": [
      "@putenv XDEBUG_MODE=coverage",
      "infection --threads=max --min-msi=80 --min-covered-msi=80"
    ],
    "infect:ci": [
      "@putenv XDEBUG_MODE=coverage",
      "infection --ansi --threads=max --logger-github --show-mutations=0 --min-msi=80 --min-covered-msi=80"
    ],
    "psalm": "psalm -c vendor-bin/psalm/psalm.xml",
    "psalm:baseline": "psalm -c vendor-bin/psalm/psalm.xml --set-baseline=vendor-bin/psalm/psalm-baseline.xml",
    "psalm:ci": "psalm -c vendor-bin/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
    "refactor": "rector process --config=rector.php",
    "refactor:ci": "rector process --config=rector.php --dry-run --ansi",
    "test": "testo"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": false,
      "target-directory": "vendor-bin"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
